@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home Page";
}

<h3>Patient Lab Reports</h3>

<div class="tab-buttons">
    <button class="tabBtn active" data-target="tabViewData" id="btnViewData">Patient Analytics Dashboard</button>
    <button class="tabBtn" data-target="tabPatientList" id="btnPatientList">Patient List & Detail</button>
    <button class="tabBtn" data-target="tabSmartCity" id="btnSmartCityList">Health Alerts & Actions</button>
</div>

<!-- Dashboard Tab -->
<div id="tabViewData" class="tabContent activeTab">
    <h2>Patient Analytics Dashboard</h2>
@*     <button id="refreshDataBtn">Refresh Data & Graphs</button> *@

    <div id="graphsContainer" class="row">
        <div class="col-md-6">
            <canvas id="labTestTypeChart" width="400" height="200"></canvas>
            <div class="text-center mb-3">
                <button id="btnLabTestAnalysis" class="btn btn-outline-primary btn-sm">Generate Summary</button>
            </div>
            <div id="analysisLabTest" style="background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 5px; max-height: 250px; overflow-y: auto; display: none;"></div>
        </div>
        <div class="col-md-6">
            <canvas id="labLocationChart" width="400" height="200"></canvas>
            <div class="text-center mb-3">
                <button id="btnLabLocationAnalysis" class="btn btn-outline-primary btn-sm">Generate Summary</button>
            </div>
            <div id="analysisLabLocation" style="background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 5px; max-height: 250px; overflow-y: auto; display: none;"></div>
        </div>
        <div class="col-md-6">
            <canvas id="familyHistoryChart" width="400" height="200"></canvas>
            <div class="text-center mb-3">
                <button id="btnFamilyHistoryAnalysis" class="btn btn-outline-primary btn-sm">Generate Summary</button>
            </div>
            <div id="analysisFamilyHistory" style="background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 5px; max-height: 250px; overflow-y: auto; display: none;"></div>
        </div>
        <div class="col-md-6">
            <canvas id="transferChart" width="400" height="200"></canvas>
            <div class="text-center mb-3">
                <button id="btnTransferAnalysis" class="btn btn-outline-primary btn-sm">Generate Summary</button>
            </div>
            <div id="analysisTransfer" style="background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 5px; max-height: 250px; overflow-y: auto; display: none;"></div>
        </div>
    </div>

    <div class="mb-3">
        <h3 style="margin-top: 40px;">AI Insights</h3>
        <p style="font-style: italic; color: #666;">
            Click "Generate AI Analysis" to get a summarized overview, trends, and management recommendations based on the patient data.
        </p>
        <button id="generateAIAnalysisBtn" class="btn btn-outline-primary">Generate AI Analysis</button>
    </div>
    <div id="aiAnalysisBox" style="background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 5px; min-height: 100px; overflow-y: auto;"></div>
    <div id="analysisMessage" style="color: red; margin-top: 10px;"></div>
</div>

<!-- Patient List Tab -->

<div id="tabPatientList" class="tabContent">
    <h2>Patient List</h2>
    <div id="patientList">Loading patients...</div>

    <div id="patientDetail" style="display:none;">
        <h3>Patient Details: <span id="selectedPatientName"></span></h3>
        <div><strong>Lab Reports:</strong></div>
        <div id="patientReports">Loading reports...</div>

        <div id="patientSummaryButtons">
            <button id="btnSummarizeBackground">Summarize Patient Background</button>
            <button id="btnDeviceData">Summarize Device Data</button>
            <button id="btnSummarizePrediction">Prediction</button>
            <button id="btnPreventIllness">Prevention Advice</button>
        </div>

        <div id="patientAIAnalysisBox" style="margin-top:10px; border:1px solid #ccc; padding:10px; background:#fff; min-height:150px; overflow-y:auto;"></div>
    </div>
</div>

<!-- Smart City Analytics Tab -->
<div id="tabSmartCity" class="tabContent">
    <h2>Health Alerts & Actions</h2>
    <p style="font-style: italic; color: #666;">
        Insights from patient data are summarized below. Admin can also trigger actions (alerts, routes, invites).
    </p>
    <button id="generateSmartCityBtn" style="padding: 10px 15px; cursor: pointer;">Generate Smart City Analysis</button>

    <div id="smartCityBox" class="analysis-box mb-3">Waiting for analysis...</div>

    <div id="smartCityActions">
        <table id="patientTable" class="table table-responsive" style="width:100%; display:none;">
            <thead>
                <tr>
                    <th>Patient Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>




<script>
    var API_KEY = '@Configuration["GROQ_API_KEY"]';
</script>

@section Scripts{
    <link href="https://cdn.datatables.net/v/bs5/jq-3.7.0/jszip-3.10.1/dt-2.3.4/b-3.2.5/b-html5-3.2.5/b-print-3.2.5/fh-4.0.3/r-3.0.6/sc-2.4.3/datatables.min.css" rel="stylesheet" integrity="sha384-QqXLMZy/L3JyB80RBJ6TrmQSNXgPKie4cv0VKRTL9yFWUf+yxR/L5e1BU0M/HLm8" crossorigin="anonymous">
    <script src="https://cdn.datatables.net/v/bs5/jq-3.7.0/jszip-3.10.1/dt-2.3.4/b-3.2.5/b-html5-3.2.5/b-print-3.2.5/fh-4.0.3/r-3.0.6/sc-2.4.3/datatables.min.js" integrity="sha384-135C0hAYleWzaU2ws28A2D0Psug/pYNMTSoAGWwTuWKNCMJtjbKy0nt4hKDten3c" crossorigin="anonymous"></script>
    <script type="module" src="~/js/app.js"></script>
    <script type="module" src="~/js/ai.js"></script>
}
